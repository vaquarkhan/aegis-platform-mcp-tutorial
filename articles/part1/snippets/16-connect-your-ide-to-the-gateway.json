{
  "inputs": [
    {
      "type": "promptString",
      "id": "aegis-token",
      "description": "Aegis bearer token (the reader value from run/keys/tokens.json)",
      "password": true
    }
  ],
  "servers": {
    "aegis-platform": {
      "type": "http",
      "url": "http://127.0.0.1:18080/mcp",
      "headers": {
        "Authorization": "Bearer ${input:aegis-token}"
      }
    }
  }
}
